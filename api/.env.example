# ===========================================================================
# PMS API environment configuration
# Copy this file to `.env` and adjust values. NEVER commit `.env`.
# ===========================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=8000
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api/v1

# --- Database (XAMPP MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pms
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# --- Auth (JWT) ---
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-please-use-random-64-bytes-hex
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-random-64-bytes-hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=pms-api
JWT_AUDIENCE=pms-web

# --- Default admin bootstrap ---
SEED_ADMIN_EMAIL=admin@pms.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
SEED_ADMIN_LOCALE=en
SEED_ADMIN_TIMEZONE=UTC

# --- Multi-tenancy ---
MULTI_TENANCY=true
DEFAULT_TENANT_NAME=Acme Corporation

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# --- i18n ---
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fr,es,de,hi,zh

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- Redis (optional: queues, caching, slow-down store). Leave empty to degrade gracefully. ---
REDIS_URL=
QUEUE_CONCURRENCY=5

# --- SMTP / email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PMS <no-reply@pms.local>"

# --- Observability ---
SENTRY_DSN=
ENABLE_METRICS=true